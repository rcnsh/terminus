<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  The app's exception to the hardened runtime (build.sh signs with
  options runtime). Only the app gets it; the frameworks and Sparkle's
  helpers are signed without any. Library validation stays on: Sparkle and
  MapLibre are re-signed with the app's Developer ID, so they share its
  Team ID.

  personal-information.location: the hardened runtime denies Core Location
  without it; the app starts from the stop nearest the user.
-->
<dict>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
