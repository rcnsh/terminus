<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>sh.rcn.terminus</string>
    <key>CFBundleName</key><string>terminus</string>
    <key>CFBundleDisplayName</key><string>terminus</string>
    <key>CFBundleExecutable</key><string>Terminus</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.3.7</string>
    <key>CFBundleVersion</key><string>23</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <!-- Menu bar only: no Dock icon, no app menu. -->
    <key>LSUIElement</key><true/>
    <!-- Sparkle: check every 6 hours, download and install without asking.
         Updates must be signed with this EdDSA key (private half in
         ~/.terminus/sparkle-ed25519.key and the SPARKLE_ED_PRIVATE_KEY secret). -->
    <key>SUFeedURL</key><string>https://terminus.rcn.sh/download/appcast.xml</string>
    <key>SUPublicEDKey</key><string>hVfiuBLXkgVXlxhaM13MRWLb3C0SrY2PDsg0zAkMx5I=</string>
    <key>SUEnableAutomaticChecks</key><true/>
    <key>SUAutomaticallyUpdate</key><true/>
    <key>SUScheduledCheckInterval</key><integer>21600</integer>
    <key>NSLocationUsageDescription</key>
    <string>terminus uses your location to start from the bus stop you're nearest.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>terminus uses your location to start from the bus stop you're nearest.</string>
</dict>
</plist>
