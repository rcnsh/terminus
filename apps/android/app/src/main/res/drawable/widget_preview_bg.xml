<?xml version="1.0" encoding="utf-8"?>
<!-- The big widget for the picker: Now's noon sky over the page, the hills between. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_page" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:bottom="84dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#5EA8E5" android:centerColor="#8EC4EC" android:endColor="#E3F0F8" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
    <item android:bottom="72dp" android:gravity="bottom|fill_horizontal" android:height="34dp" android:drawable="@drawable/widget_preview_hills" />
</layer-list>
