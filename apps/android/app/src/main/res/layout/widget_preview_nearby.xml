<?xml version="1.0" encoding="utf-8"?>
<!-- What "Buses near you" looks like, for the widget picker: the stop at noon,
     two services side by side. Sample times are a picture, not UI copy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,UselessLeaf,DisableBaselineAlignment"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:paddingHorizontal="14dp" android:paddingTop="12dp" android:paddingBottom="10dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/preview_nearby_now" android:textSize="12sp"
        android:textColor="@color/brand_sky_muted" android:maxLines="1" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="University Town" android:textSize="19sp" android:textStyle="bold"
        android:textColor="@color/brand_ink" android:maxLines="1" />
    <!-- Spacer: RemoteViews has no plain View. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D1"
                    android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF"
                    android:background="@drawable/widget_preview_badge" android:backgroundTint="#EC4FA0"
                    android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:layout_marginEnd="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9:42"
                    android:textSize="24sp" android:textStyle="bold" android:textColor="@color/brand_ink" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/preview_nearby_next_1" android:textSize="13sp"
                android:textColor="@color/brand_ink" android:maxLines="2" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="10dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D2"
                    android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF"
                    android:background="@drawable/widget_preview_badge" android:backgroundTint="#8E44C9"
                    android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:layout_marginEnd="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9:45"
                    android:textSize="24sp" android:textStyle="bold" android:textColor="@color/brand_ink" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/preview_nearby_next_2" android:textSize="13sp"
                android:textColor="@color/brand_ink" android:maxLines="2" android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
