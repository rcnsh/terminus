<?xml version="1.0" encoding="utf-8"?>
<!-- What "Buses near you" looks like, for the widget picker: both sides of
     the road at Yusof Ishak House, a row a bus. Sample times are a picture, not UI copy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText,UselessLeaf,DisableBaselineAlignment,UselessParent"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
