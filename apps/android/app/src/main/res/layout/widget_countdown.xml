<?xml version="1.0" encoding="utf-8"?>
<!-- "in 04:32" beside a bus on a Nearby widget. A Chronometer counts down by
     itself, as "Now 9:41" ticks (widget_now_clock), so the widget isn't
     redrawn every second; the widget sets its base, words, colour and size
     (Countdown in NearbyLayouts). -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"
    android:countDown="true" android:maxLines="1" />
