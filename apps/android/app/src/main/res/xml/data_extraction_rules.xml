<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the account is backed up or moved to a new phone. The token
     is encrypted with a Keystore key that does not travel, so a restored
     copy could never be decrypted anyway; the rest (the widgets' answers and
     day plan, with class names, the campus copy, the street map, the jobs'
     database) belongs to that account and is fetched again after signing in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
