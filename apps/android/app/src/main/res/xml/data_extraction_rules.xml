<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the token is encrypted with a Keystore key that
     does not travel, so a restored copy could never be decrypted anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
