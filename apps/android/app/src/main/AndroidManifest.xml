<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the connection is metered: a newer street map waits for Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- No background location: Play rejects most uses of it. In the
         background the widget follows the timetable and the trip's state. -->
    <!-- Re-arms the widget refresh after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Time to leave" for class, if turned on in the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The heads-up on time. Play allows USE_EXACT_ALARM only for alarm
         clocks and calendars, so this is the one the user allows ("Alarms &
         reminders"); without it the alarms are inexact, a few minutes late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The optional live notification during your day. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- A widget button's moment in the foreground to take a location fix
         (WidgetModeService), started only by the tap (while-in-use). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 16: the live notification as a Live Update during a trip (granted at install). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:name=".TerminusApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Terminus">

        <!-- A theme or language chosen in Settings redraws the app in place
             (MainActivity.onConfigurationChanged) rather than starting it
             again, which blanked the screen for a moment. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="uiMode|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The account page's pairing QR code. Verified via
                 the site's /.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${siteHost}" android:pathPrefix="/pair" />
            </intent-filter>
            <!-- Share in NUSMods, then terminus: imports the timetable link. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.NextBusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_bus_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PlacesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_places_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/places_widget_info" />
        </receiver>
        <!-- The widget's refresh alarm, and the system events after which its
             pre-drawn text is wrong. System broadcasts reach it unexported. -->
        <receiver
            android:name=".widget.RefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <!-- "Alarms & reminders" allowed: re-arm the alarms as exact ones. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Leave-alert alarms. Only this app's own PendingIntents reach it. -->
        <receiver
            android:name=".LeaveReceiver"
            android:exported="false" />
        <!-- Push: the server says the card changed. Only with Play services. -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Live notification. specialUse: none of the typed services fit a
             bus countdown, and dataSync is capped at 6 hours a day. -->
        <service
            android:name=".LiveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live campus bus countdown in an ongoing notification, on only while the user's day is on and the user has turned it on." />
        </service>
        <receiver
            android:name=".LiveReceiver"
            android:exported="false" />
        <!-- A widget button (Nearby, a place): a moment in the foreground to take
             a location fix, started only by the tap. shortService without
             location permission. -->
        <service
            android:name=".widget.WidgetModeService"
            android:exported="false"
            android:foregroundServiceType="location|shortService" />
    </application>
</manifest>
