# Copy to .dev.vars and fill in. The keys are not included in this repository.
# Commit NOTHING from here.
#
# Variable names match hewliyang/nus-nextbus-web's .env.example so that repo's
# notes stay applicable.

# The flow:
#   POST {NEXTBUS_AUTH_BASE}/get-access-token
#   headers: X-HTD-API, X-APP-API
#   body:    {"deviceid","ipaddr","version"}
#   ->       {"code":"00000","data":{"token","userid","domain","username"}}
# Token lifetime is 24h and lives only in the JWT's exp claim; there is no
# expires_in field. No NUSNET credentials anywhere -- domain is PUBLIC.
NEXTBUS_AUTH_BASE="https://myizaac2.nus.edu.sg/univus-public/mobile"

# Bus data. Since 2026-09-05 uNivUS POSTs to this proxy instead of calling
# ConnectX directly (as of uNivUS 2.59.2). Auth is the same guest JWT
# from get-access-token, as a Bearer header AND in the body, plus x-api-key.
NEXTBUS_PROXY_BASE="https://inetapps.nus.edu.sg/univus/api/bus-proxy"

# Fixed app constant sent as x-api-key to the proxy.
NEXTBUS_PROXY_API_KEY=""

# Must track the current Play Store release. When NUS ships a new uNivUS, the
# old string starts being rejected with code 10009 "We have a new release of
# uNivUS" and every answer degrades to `unknown`. Format:
# univus_android_<versionName>_<versionCode>.
NEXTBUS_APP_VERSION="univus_android_2.59.2_140"

# The auth headers for get-access-token. Without them the endpoint returns
# HTTP 200 with {"code":"10000","msg":"Invalid API KEY"}.
NEXTBUS_HTD_API=""
NEXTBUS_APP_API=""

# Optional. Any 16 hex characters; generated and persisted in KV when absent.
# Not a secret -- it is an Android ID -- but keep it stable so the upstream
# sees one install rather than a new device on every cold start.
NEXTBUS_DEVICE_ID=""

# Optional. uNivUS sends these via Dio; the server does not require them.
NEXTBUS_REQUESTED_BY=""
NEXTBUS_SECURED_REQUEST=""

