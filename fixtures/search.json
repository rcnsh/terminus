{
  "about": [
    "Destination search, as every client ranks it: the web app (apps/web/public/account/search.js, the reference, checked by apps/api/test/search.test.js) and the Android and Mac apps.",
    "Two sections. \"destinations\": the search on Now and in Settings, over /campus `destinations`, ranked by rank(). \"busesTab\": the Buses tab's search, over an index built from /campus by busesTabIndex(), then ranked by the same rank().",
    "Results are listed as \"kind:code\" ids, in order: a code alone is not unique (the stop COM3 and the building COM3)."
  ],
  "rules": {
    "query": "Trim leading and trailing whitespace (JavaScript trim(): spaces, tabs, newlines, Unicode spaces), then lower-case it: that is q. An empty q has no results (the Buses tab shows its suggestions instead: see busesTab.rules).",
    "names": "Each entry's names are its code, its label and each alias, all lower-cased. Aliases are lower case from /campus but are lower-cased anyway.",
    "normalise": "norm(s): lower-case, then remove every run of whitespace, hyphens (-) and underscores (_). Only the code and the query are normalised, and only for the code checks in scores 0 and 1. When norm(q) is empty (the query was only hyphens or underscores), the code checks are skipped.",
    "score": [
      "0 exact: q equals a name, or norm(code) equals norm(q).",
      "1 starts with: a name starts with q, or norm(code) starts with norm(q).",
      "2 a word starts with: a name split on runs of whitespace and ( ) · , / & - has a non-empty word starting with q. Underscores, apostrophes and dots do not split.",
      "3 contains: a name contains q.",
      "Otherwise no match. The first that holds is the score; labels and aliases are never normalised, so their spaces must match as typed."
    ],
    "rooms": "Entries of kind \"room\" are left out unless the trimmed query is at least 2 characters long (UTF-16 code units, before lower-casing).",
    "order": [
      "By score, lowest first.",
      "Then by kind: timetable, place, class, service, stop, landmark, building, room, then any other kind (all other kinds equal, after room).",
      "Then by label length, shortest first (UTF-16 code units: Kotlin String.length, Swift label.utf16.count, of the label as given).",
      "Then in the order of the index: the sort is stable."
    ],
    "limit": "At most `limit` results (8), after sorting.",
    "text": "All comparisons are plain string comparisons (no locale collation, no accent folding)."
  },
