        "why": "A word of \"prince george's park\" (2): an apostrophe does not split words."
      },
      {
        "q": "prince",
        "expect": [
          "stop:PGP"
        ],
        "why": "Starts the label (1)."
      },
      {
        "q": "kv",
        "expect": [
          "stop:KV"
        ],
        "why": "The code (0). KV has no longName, so its label is its name, \"Kent Vale\"."
      },
      {
        "q": "vale",
        "expect": [
          "stop:KV"
        ],
        "why": "A word of the label (2)."
      },
      {
        "q": "fass",
        "expect": [],
        "why": "Only the aliases of /campus destinations of kind \"stop\" count: AS1's are a building's, and AS5 has none here."
      },
      {
        "q": "btc",
        "expect": [
          "service:BTC"
        ],
        "why": "The service (0)."
      },
      {
        "q": "b",
        "expect": [
          "service:BTC",
          "stop:KRB",
          "stop:CLB"
        ],
        "why": "BTC starts with it (1); KRB has a word \"bus\" (2); CLB contains it (3)."
      },
      {
        "q": "t",
        "expect": [
          "stop:UTOWN",
          "stop:KRB",
          "service:BTC",
          "stop:KV",
          "stop:KR-MRT",
          "stop:CLB"
        ],
        "why": "Words \"town\" and \"terminal\" (2); then BTC contains it (3) and, as a service, comes before stops that contain it."
      },
      {
        "q": "zzz",
        "expect": [],
        "why": "No match."
      }
    ]
  }
}
