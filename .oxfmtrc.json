{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "quoteProps": "preserve",
  "objectWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "sortPackageJson": false,
  "ignorePatterns": [
    "apps/web/public/vendor/**",
    "apps/api/data/**",
    "apps/api/test/fixtures/**",
    "**/*.html",
    "**/*.css",
    "apps/api/cloudflare.config.ts",
    "pnpm-lock.yaml",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.min.*",
    "**/build/**",
    "**/.build/**",
    "**/.gradle/**",
    "**/dist/**",
    "**/.wrangler/**"
  ]
}
